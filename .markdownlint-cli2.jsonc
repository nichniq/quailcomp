{
  "config": {
    "default": true,
    "MD012": false,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": false,
    "MD029": false,
    "MD031": true,
    "MD032": true,
    "MD033": false,
    "MD036": false,
    "MD040": false,
