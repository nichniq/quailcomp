{
  "name": "quailcomp",
  "type": "module",
  "private": true,
  "workspaces": ["data/client", "server", "frontend"],
  "scripts": {
    "test": "bun test --cwd data/client && bun test --cwd server",
    "test:watch": "bun test --watch --cwd data/client",
    "db:setup": "bun run --cwd data/client setup",
    "db:teardown": "bun run --cwd data/client teardown",
    "db:migrate": "bun run --cwd data/client migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "install-hooks": "bash scripts/install-hooks.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "bun-types": "^1.3.7",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.7.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
