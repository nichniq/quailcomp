{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "./dist-types",
    "baseUrl": ".",
    "paths": {
      "@quailcomp/data": ["../data/client/src"],
      "@quailcomp/book-metadata": ["../services/book-metadata"],
      "@domains/types/*": ["../domains/dist/*"],
      "@cli/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "dist-types"],
  "references": [
    { "path": "../domains" },
    { "path": "../data/client" },
    { "path": "../services/book-metadata" }
  ]
}
