# Example environment variables for database bootstrap
# Copy this file to .env and fill in real values for local development
# DO NOT commit .env to source control

# Database host
PGHOST=localhost

# Database port
PGPORT=5432

# Admin role used only for database setup
PGUSER=postgres

# Password for the above admin role; remove if no password needed
PGPASSWORD=<password_change_me>

# Database to connect to for bootstrap
PGDATABASE=postgres
