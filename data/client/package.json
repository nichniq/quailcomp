{
  "name": "@quailcomp/data",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:coverage:lcov": "bun test --coverage --coverage-reporter=lcov",
    "typecheck": "tsc --build",
    "typecheck:force": "tsc --build --force",
    "build": "echo 'No build needed (TypeScript library)'",
    "setup": "bun run scripts/setup-test-db.ts",
    "teardown": "bun run scripts/teardown-test-db.ts",
    "migrate": "bun run scripts/run-migrations.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fast-check": "^4.5.3"
  }
}
