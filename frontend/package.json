{
  "name": "quailcomp-frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:force": "vue-tsc --noEmit",
    "test": "bunx vitest run",
    "test:ui": "bunx vitest --ui",
    "test:coverage": "bunx vitest --coverage"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "pinia": "^2.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.4.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18",
    "vitest-localstorage-mock": "^0.1.2",
    "vue-tsc": "^1.8.0"
  }
}
