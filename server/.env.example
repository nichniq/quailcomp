# Database
# For local development with no password (default PostgreSQL setup):
DATABASE_URL=postgres://quailcomp_app@localhost:5432/quailcomp
# Or with password:
# DATABASE_URL=postgres://quailcomp_app:your_password@localhost:5432/quailcomp

# Server configuration
PORT=3000
LOG_LEVEL=info

# Authentication
# IMPORTANT: Change this in production! Must be at least 32 characters.
JWT_SECRET=development-secret-change-me-in-production
JWT_EXPIRES_IN=3600
