# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quailcomp
DB_USER=quailcomp_app
DB_PASSWORD=your_password_here

# Test database
DB_TEST_NAME=quailcomp_test

# Superuser for setup scripts (usually your OS username)
# DB_SUPERUSER=nichmaq

# Server configuration
PORT=3000
LOG_LEVEL=info

# Authentication
# IMPORTANT: Change this in production! Must be at least 32 characters.
JWT_SECRET=development-secret-change-me-in-production
JWT_EXPIRES_IN=3600
