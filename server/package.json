{
  "name": "quailcomp-server",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:coverage:lcov": "bun test --coverage --coverage-reporter=lcov"
  },
  "dependencies": {
    "@quailcomp/book-metadata": "workspace:*",
    "@quailcomp/data": "workspace:*",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
